# Nastavujte jako serverové proměnné prostředí, nikoli NEXT_PUBLIC_*.
# Soukromé nasazení může fungovat se Sites identity a D1/R2 bez Supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Volitelné skutečné doručování oznámení (ověřená doména u Resend):
RESEND_API_KEY=
EMAIL_FROM=
# Přesná ověřená identita, z /api/v1/me po přihlášení provozovatele.
# Formát sites:<stabilní ID> nebo supabase:<UUID>. Není to e-mail.
ADMIN_USER_ID=
# Volitelný jednorázový bootstrap výhradně ověřeného e-mailu provozovatele.
# Ukládejte jako serverový secret. Po prvním úspěšném přiřazení odstraňte.
ADMIN_BOOTSTRAP_EMAIL=
SITE_ORIGIN=https://podporao.cz
